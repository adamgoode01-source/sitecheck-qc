node_modules/
dist/
dist-electron/
release/

# The Xcode project is generated by `npx cap add ios` on every CI run rather
# than committed — see codemagic.yaml. If you later get a Mac and want to set
# icons and plist keys once in Xcode instead of patching them in CI, commit
# it and delete the patch steps.
#
# The leading slash matters. Unanchored `ios/` matches a directory of that
# name at ANY depth, which silently excluded the ARKit plugin's own
# `packages/capacitor-sitecheck-ar/ios/` sources — CocoaPods then builds an
# empty pod and the app fails at runtime with "plugin not implemented",
# which is a long way from the cause.
/ios/

expo-app/node_modules/
expo-app/.expo/
expo-app/.expo-export-check/

*.log
.DS_Store
